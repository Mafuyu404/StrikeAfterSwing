{
  "_comment": "命令模板，按版本覆盖时放在 targets/<name>/behavior-test.json。占位符由 behavior_test.py 填充。",
  "rconPort": 25575,
  "serverPort": 25565,
  "worldSetup": [
    "difficulty hard",
    "gamerule doDaylightCycle false",
    "gamerule doWeatherCycle false",
    "gamerule doMobSpawning false",
    "gamerule sendCommandFeedback true",
    "time set midnight",
    "weather clear",
    "kill @e[type=!player]"
  ],
  "_comment_siteSetup": "先把场地空间清到 y=95..110 再铺平台：只铺 y=100 一层不够，测试世界里残留的地形方块会把刚召唤的攻击者卡住（曾表现为僵尸整场一次都不挥击）。forceload 的参数是方块坐标（取其所在区块），必须覆盖整个场地矩形：全新世界里只要有一个相关区块没加载，紧接着的 fill 就会报 That position is not loaded。",
  "siteSetup": [
    "forceload add {padX1} {padZ1} {padX2} {padZ2}",
    "fill {padX1} 95 {padZ1} {padX2} 110 {padZ2} minecraft:air",
    "fill {padX1} {padY} {padZ1} {padX2} {padY} {padZ2} minecraft:stone",
    "kill @e[type=!player,x={x},y={padY},z={z},distance=..16]"
  ],
  "spawnTarget": "summon minecraft:villager {x} {y} {z} {{Tags:[\"{targetTag}\"],NoAI:1b,PersistenceRequired:1b}}",
  "spawnAttacker": "summon minecraft:{attacker} {attackerX} {y} {z} {{Tags:[\"{attackerTag}\"],PersistenceRequired:1b}}",
  "longSwing": "effect give @e[tag={attackerTag},limit=1] minecraft:mining_fatigue 900 255 true",
  "_comment_slowAttacker": "减速只用来阻止攻击者追击撤出范围的村民，级别取 5（速度约 0.1 倍）而不是 255：MOVEMENT_SPEED 的修饰符是 MULTIPLY_TOTAL，255 级在 1.20.1 上会把速度推成负数，攻击者于是完全不挥击，测试会误报成'模组没工作'。",
  "slowAttacker": "effect give @e[tag={attackerTag},limit=1] minecraft:slowness 99999 5 true",
  "escapeTarget": "tp @e[tag={targetTag},limit=1] {escapeX} {y} {z}",
  "queryEffects": "data get entity @e[tag={attackerTag},limit=1]",
  "queryHealth": "data get entity @e[tag={tag},limit=1] Health",
  "queryTargetEffects": "data get entity @e[tag={tag},limit=1]",
  "queryTick": "time query gametime"
}
