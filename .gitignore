# Local secrets: publish tokens live in .env and must never be committed. They are
# read from the environment (CURSEFORGE_TOKEN, MODRINTH_TOKEN, SIGHS_PUBLISH_USER,
# SIGHS_PUBLISH_PASSWORD) and only the project IDs belong in gradle.properties.
.env
.env.*
!.env.example

# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Working directories: the dedicated server run dirs and Forge data-generation output
run/
run-data/

# targets/<name>/libs/ intentionally holds local dependencies; commit a jar there only
# when the build really needs it, since binaries are a poor fit for git.
targets/*/run/
targets/*/.gradle/
targets/*/build/
common/.gradle/
common/build/

# Python bytecode cache, created by running scripts/behavior-test/*.py directly
# (the PowerShell driver sets PYTHONDONTWRITEBYTECODE).
__pycache__/
*.pyc
